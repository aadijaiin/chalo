{
  "expo": {
    "name": "chalo",
    "slug": "chalo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chalo",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chalo.app"
    },
    "android": {
      "package": "com.chalo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E2725B"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "imageWidth": 160,
          "backgroundColor": "#FAF7F2",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#111311"
          }
        }
      ],
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "chalo shows your live position on the map and shares it only with parties you join."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2cbabf72-61e7-40e1-8367-ae91d4d26584"
      }
    },
    "owner": "aadijaiin"
  }
}
