# Supabase → Project Settings → API (free tier, no card needed)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" (or legacy "anon") key. Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Where the web site is deployed (web/), for tappable invite links: https://<domain>/j/<code>.
# Leave unset to share chalo:// links instead.
EXPO_PUBLIC_INVITE_URL=
