# Supabase → Project Settings → API (free tier, no card needed)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" (or legacy "anon") key. Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# The website (web/): tappable invite links (https://<domain>/j/<code>) and the page
# password-reset emails open (/reset-password). Leave unset to share chalo:// links instead.
EXPO_PUBLIC_SITE_URL=https://chalo.aadijain.dev
