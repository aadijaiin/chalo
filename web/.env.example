# The same Supabase project and *publishable* key the app uses (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Shown on the privacy, terms and delete-account pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. The Android download defaults to the latest GitHub release's chalo.apk.
NEXT_PUBLIC_APK_URL=
# Optional. Store buttons appear on the site once these are set.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
